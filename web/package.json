  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
